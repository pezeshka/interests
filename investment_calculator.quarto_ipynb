{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "title: \"Investment Calculator\"\n",
        "subtitle: \"A First Pass at Retirement Planning\"\n",
        "format: html\n",
        "---\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "This is regular text in your Quarto document. Notice that the calculator's styling below does not affect this paragraph. You can write your analysis, explanations, or other content here as usual.\n",
        "\n",
        "<div id=\"calculator-container\" class=\"p-4\"></div>\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "```{html}\n",
        "<!-- Load dependencies -->\n",
        "<script src=\"https://cdn.tailwindcss.com\"></script>\n",
        "<script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n",
        "\n",
        "<script>\n",
        "document.addEventListener('DOMContentLoaded', function () {\n",
        "\n",
        "    // --- 1. Define the HTML structure for the calculator ---\n",
        "    const calculatorHTML = `\n",
        "        <div class=\"grid grid-cols-1 lg:grid-cols-4 gap-8\">\n",
        "            <div class=\"lg:col-span-1\">\n",
        "                <div class=\"card space-y-4\">\n",
        "                    <h2 class=\"text-xl font-semibold text-gray-700\">Financial Inputs</h2>\n",
        "                    \n",
        "                    <div>\n",
        "                        <label for=\"initial_investment\" class=\"block text-sm font-medium text-gray-700\">Initial Investment ($)</label>\n",
        "                        <input type=\"number\" id=\"initial_investment\" value=\"10000\" min=\"0\" class=\"mt-1 w-full border rounded p-2\">\n",
        "                    </div>\n",
        "\n",
        "                    <div>\n",
        "                        <label for=\"contribution\" class=\"block text-sm font-medium text-gray-700\">Contribution Amount ($)</label>\n",
        "                        <input type=\"number\" id=\"contribution\" value=\"500\" min=\"0\" class=\"mt-1 w-full border rounded p-2\">\n",
        "                    </div>\n",
        "\n",
        "                    <div>\n",
        "                        <label for=\"pay_frequency\" class=\"block text-sm font-medium text-gray-700\">Contribution Frequency</label>\n",
        "                        <select id=\"pay_frequency\" class=\"mt-1 w-full border rounded p-2\">\n",
        "                            <option value=\"52\">Weekly</option>\n",
        "                            <option value=\"26\" selected>Bi-weekly</option>\n",
        "                            <option value=\"24\">Semi-monthly</option>\n",
        "                            <option value=\"12\">Monthly</option>\n",
        "                        </select>\n",
        "                    </div>\n",
        "                    \n",
        "                    <div>\n",
        "                        <label for=\"years\" class=\"block text-sm font-medium text-gray-700\">Investment Duration (Years): \n",
        "                            <span id=\"years-label\" class=\"font-bold\">20</span>\n",
        "                        </label>\n",
        "                        <input type=\"range\" id=\"years\" min=\"1\" max=\"50\" value=\"20\" \n",
        "                               class=\"w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer mt-1\">\n",
        "                    </div>\n",
        "\n",
        "                    <hr class=\"my-4\">\n",
        "                    <h3 class=\"text-lg font-semibold text-gray-700\">Scenario Rates of Return</h3>\n",
        "\n",
        "                    <div>\n",
        "                        <label for=\"bear_rate\" class=\"block text-sm font-medium text-gray-700\">Bear Case (%): \n",
        "                            <span id=\"bear-rate-label\" class=\"font-bold text-red-600\">4.0</span>\n",
        "                        </label>\n",
        "                        <input type=\"range\" id=\"bear_rate\" min=\"0\" max=\"20\" value=\"4\" step=\"0.1\" \n",
        "                               class=\"w-full h-2 bg-red-100 rounded-lg appearance-none cursor-pointer mt-1\">\n",
        "                    </div>\n",
        "                    \n",
        "                    <div>\n",
        "                        <label for=\"base_rate\" class=\"block text-sm font-medium text-gray-700\">Base Case (%): \n",
        "                            <span id=\"base-rate-label\" class=\"font-bold text-blue-600\">7.0</span>\n",
        "                        </label>\n",
        "                        <input type=\"range\" id=\"base_rate\" min=\"0\" max=\"20\" value=\"7\" step=\"0.1\" \n",
        "                               class=\"w-full h-2 bg-blue-100 rounded-lg appearance-none cursor-pointer mt-1\">\n",
        "                    </div>\n",
        "\n",
        "                    <div>\n",
        "                        <label for=\"bull_rate\" class=\"block text-sm font-medium text-gray-700\">Bull Case (%): \n",
        "                            <span id=\"bull-rate-label\" class=\"font-bold text-green-600\">10.0</span>\n",
        "                        </label>\n",
        "                        <input type=\"range\" id=\"bull_rate\" min=\"0\" max=\"20\" value=\"10\" step=\"0.1\" \n",
        "                               class=\"w-full h-2 bg-green-100 rounded-lg appearance-none cursor-pointer mt-1\">\n",
        "                    </div>\n",
        "\n",
        "                    <button id=\"calculate\" class=\"w-full btn-primary mt-4\">Calculate Growth</button>\n",
        "                </div>\n",
        "            </div>\n",
        "\n",
        "            <div class=\"lg:col-span-3\">\n",
        "                <div class=\"card\">\n",
        "                    <h2 class=\"text-xl font-semibold text-gray-700 mb-4\">Growth Comparison</h2>\n",
        "                    <div class=\"w-full h-96\">\n",
        "                        <canvas id=\"growthChart\"></canvas>\n",
        "                    </div>\n",
        "                </div>\n",
        "                <div class=\"card mt-8\">\n",
        "                    <h2 class=\"text-xl font-semibold text-gray-700 mb-4\">Investment Summary</h2>\n",
        "                    <div id=\"summaryText\" class=\"text-gray-700\">\n",
        "                        <p>Click \"Calculate Growth\" to see your projection.</p>\n",
        "                    </div>\n",
        "                </div>\n",
        "            </div>\n",
        "        </div>\n",
        "    `;\n",
        "\n",
        "    // --- 2. Insert calculator HTML ---\n",
        "    const host = document.querySelector('#calculator-container');\n",
        "    host.innerHTML = calculatorHTML;\n",
        "\n",
        "    // --- 3. Style helpers ---\n",
        "    const addStyles = () => {\n",
        "        const style = document.createElement('style');\n",
        "        style.textContent = `\n",
        "            .card { background-color: white; border-radius: 0.75rem; \n",
        "                box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), \n",
        "                            0 2px 4px -2px rgb(0 0 0 / 0.1); \n",
        "                padding: 1.5rem; }\n",
        "            .btn-primary { background-color: #3b82f6; color: white; \n",
        "                font-weight: 600; padding: 0.75rem 1.5rem; \n",
        "                border-radius: 0.5rem; transition: background-color 0.2s; }\n",
        "            .btn-primary:hover { background-color: #2563eb; }\n",
        "        `;\n",
        "        document.head.appendChild(style);\n",
        "    };\n",
        "    addStyles();\n",
        "\n",
        "    // --- 4. Grab elements ---\n",
        "    const calculateBtn = document.getElementById('calculate');\n",
        "    const summaryTextEl = document.getElementById('summaryText');\n",
        "    const chartCanvas = document.getElementById('growthChart');\n",
        "    const initialInvestmentEl = document.getElementById('initial_investment');\n",
        "    const contributionEl = document.getElementById('contribution');\n",
        "    const payFrequencyEl = document.getElementById('pay_frequency');\n",
        "    const yearsEl = document.getElementById('years');\n",
        "    const bearRateEl = document.getElementById('bear_rate');\n",
        "    const baseRateEl = document.getElementById('base_rate');\n",
        "    const bullRateEl = document.getElementById('bull_rate');\n",
        "    const yearsLabel = document.getElementById('years-label');\n",
        "    const bearRateLabel = document.getElementById('bear-rate-label');\n",
        "    const baseRateLabel = document.getElementById('base-rate-label');\n",
        "    const bullRateLabel = document.getElementById('bull-rate-label');\n",
        "    let growthChart;\n",
        "\n",
        "    // --- 5. Calculator logic ---\n",
        "    function calculateGrowth(initialPrincipal, years, annualRate, periodsPerYear, contribution) {\n",
        "        const currentYear = new Date().getFullYear();\n",
        "        const periodicRate = Math.pow(1 + annualRate, 1 / periodsPerYear) - 1;\n",
        "        const totalPeriods = years * periodsPerYear;\n",
        "        let balance = initialPrincipal;\n",
        "        let totalContributions = initialPrincipal;\n",
        "        let totalReturns = 0;\n",
        "        const timeline = [{ year: currentYear, balance: initialPrincipal }];\n",
        "        for (let i = 1; i <= totalPeriods; i++) {\n",
        "            const returnsThisPeriod = balance * periodicRate;\n",
        "            balance += returnsThisPeriod + contribution;\n",
        "            totalContributions += contribution;\n",
        "            totalReturns += returnsThisPeriod;\n",
        "            if (i % periodsPerYear === 0) {\n",
        "                timeline.push({ year: currentYear + (i / periodsPerYear), balance: balance });\n",
        "            }\n",
        "        }\n",
        "        if (totalPeriods % periodsPerYear !== 0) {\n",
        "            timeline.push({ year: currentYear + years, balance: balance });\n",
        "        }\n",
        "        return { timeline, final: { balance, totalContributions, totalReturns } };\n",
        "    }\n",
        "\n",
        "    function renderChart(bearData, baseData, bullData) {\n",
        "        const labels = baseData.map(d => d.year);\n",
        "        if (growthChart) {\n",
        "            growthChart.destroy();\n",
        "        }\n",
        "        const ctx = chartCanvas.getContext('2d');\n",
        "        growthChart = new Chart(ctx, {\n",
        "            type: 'line',\n",
        "            data: {\n",
        "                labels: labels,\n",
        "                datasets: [\n",
        "                    { label: `Bear (${bearRateEl.value}%)`, data: bearData.map(d => d.balance), borderColor: '#ef4444', backgroundColor: 'rgba(239, 68, 68, 0.1)', fill: true, tension: 0.1 },\n",
        "                    { label: `Base (${baseRateEl.value}%)`, data: baseData.map(d => d.balance), borderColor: '#3b82f6', backgroundColor: 'rgba(59, 130, 246, 0.1)', fill: true, tension: 0.1 },\n",
        "                    { label: `Bull (${bullRateEl.value}%)`, data: bullData.map(d => d.balance), borderColor: '#22c55e', backgroundColor: 'rgba(34, 197, 94, 0.1)', fill: true, tension: 0.1 }\n",
        "                ]\n",
        "            },\n",
        "            options: { \n",
        "                responsive: true, \n",
        "                maintainAspectRatio: false, \n",
        "                scales: { \n",
        "                    x: { title: { display: true, text: 'Year' } }, \n",
        "                    y: { \n",
        "                        title: { display: true, text: 'Portfolio Value' }, \n",
        "                        ticks: { callback: (value) => '$' + value.toLocaleString() } \n",
        "                    } \n",
        "                },\n",
        "                plugins: { \n",
        "                    tooltip: { \n",
        "                        callbacks: { \n",
        "                            label: function(context) { \n",
        "                                let label = context.dataset.label || ''; \n",
        "                                if (label) { label += ': '; } \n",
        "                                if (context.parsed.y !== null) { \n",
        "                                    label += new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(context.parsed.y); \n",
        "                                } \n",
        "                                return label; \n",
        "                            } \n",
        "                        } \n",
        "                    } \n",
        "                } \n",
        "            }\n",
        "        });\n",
        "    }\n",
        "\n",
        "    function updateSummary(bearFinal, baseFinal, bullFinal, years) {\n",
        "        const formatter = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 0, maximumFractionDigits: 0 });\n",
        "        summaryTextEl.innerHTML = `\n",
        "            <p class=\"text-lg mb-4\">After <strong>${years} years</strong>, your projected portfolio values are:</p>\n",
        "            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n",
        "                <div class=\"p-4 bg-red-50 rounded-lg\">\n",
        "                    <h4 class=\"font-bold text-lg text-red-800\">Bear Case (${bearRateEl.value}%)</h4>\n",
        "                    <p class=\"text-2xl font-extrabold text-red-600 my-2\">${formatter.format(bearFinal.balance)}</p>\n",
        "                    <ul class=\"text-sm space-y-1 text-gray-600\">\n",
        "                        <li><strong>Contributions:</strong> ${formatter.format(bearFinal.totalContributions)}</li>\n",
        "                        <li><strong>Returns:</strong> ${formatter.format(bearFinal.totalReturns)}</li>\n",
        "                    </ul>\n",
        "                </div>\n",
        "                <div class=\"p-4 bg-blue-50 rounded-lg\">\n",
        "                    <h4 class=\"font-bold text-lg text-blue-800\">Base Case (${baseRateEl.value}%)</h4>\n",
        "                    <p class=\"text-2xl font-extrabold text-blue-600 my-2\">${formatter.format(baseFinal.balance)}</p>\n",
        "                    <ul class=\"text-sm space-y-1 text-gray-600\">\n",
        "                        <li><strong>Contributions:</strong> ${formatter.format(baseFinal.totalContributions)}</li>\n",
        "                        <li><strong>Returns:</strong> ${formatter.format(baseFinal.totalReturns)}</li>\n",
        "                    </ul>\n",
        "                </div>\n",
        "                <div class=\"p-4 bg-green-50 rounded-lg\">\n",
        "                    <h4 class=\"font-bold text-lg text-green-800\">Bull Case (${bullRateEl.value}%)</h4>\n",
        "                    <p class=\"text-2xl font-extrabold text-green-600 my-2\">${formatter.format(bullFinal.balance)}</p>\n",
        "                    <ul class=\"text-sm space-y-1 text-gray-600\">\n",
        "                        <li><strong>Contributions:</strong> ${formatter.format(bullFinal.totalContributions)}</li>\n",
        "                        <li><strong>Returns:</strong> ${formatter.format(bullFinal.totalReturns)}</li>\n",
        "                    </ul>\n",
        "                </div>\n",
        "            </div>\n",
        "        `;\n",
        "    }\n",
        "\n",
        "    function handleCalculation() {\n",
        "        const initial = parseFloat(initialInvestmentEl.value);\n",
        "        const contrib = parseFloat(contributionEl.value);\n",
        "        const freq = parseInt(payFrequencyEl.value);\n",
        "        const yrs = parseInt(yearsEl.value);\n",
        "        const rateBear = parseFloat(bearRateEl.value) / 100;\n",
        "        const rateBase = parseFloat(baseRateEl.value) / 100;\n",
        "        const rateBull = parseFloat(bullRateEl.value) / 100;\n",
        "        const bearResult = calculateGrowth(initial, yrs, rateBear, freq, contrib);\n",
        "        const baseResult = calculateGrowth(initial, yrs, rateBase, freq, contrib);\n",
        "        const bullResult = calculateGrowth(initial, yrs, rateBull, freq, contrib);\n",
        "        renderChart(bearResult.timeline, baseResult.timeline, bullResult.timeline);\n",
        "        updateSummary(bearResult.final, baseResult.final, bullResult.final, yrs);\n",
        "    }\n",
        "\n",
        "    calculateBtn.addEventListener('click', handleCalculation);\n",
        "    yearsEl.addEventListener('input', (e) => yearsLabel.textContent = e.target.value);\n",
        "    bearRateEl.addEventListener('input', (e) => bearRateLabel.textContent = parseFloat(e.target.value).toFixed(1));\n",
        "    baseRateEl.addEventListener('input', (e) => baseRateLabel.textContent = parseFloat(e.target.value).toFixed(1));\n",
        "    bullRateEl.addEventListener('input', (e) => bullRateLabel.textContent = parseFloat(e.target.value).toFixed(1));\n",
        "\n",
        "    // Auto-run once\n",
        "    setTimeout(handleCalculation, 100);\n",
        "});\n",
        "</script>\n",
        "```"
      ],
      "id": "1768eab9"
    }
  ],
  "metadata": {
    "kernelspec": {
      "display_name": "Python 3",
      "language": "python",
      "name": "python3"
    }
  },
  "nbformat": 4,
  "nbformat_minor": 5
}